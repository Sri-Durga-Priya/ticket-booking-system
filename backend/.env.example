# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/ticketnow

# JWT Authentication
JWT_SECRET=ticketnow_jwt_secret_dev_key_change_in_production_987654321
JWT_EXPIRES_IN=7d

# Concurrency & Hold TTL Timers (in minutes)
HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15

# Email Service (Nodemailer)
# If left empty, emails (including QR codes) will be logged to console / saved to dev preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@ticketnow.local
